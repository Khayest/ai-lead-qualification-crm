    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const lead = $('Normalize Lead Data').item.json;\n\nconst budget = Number(lead.budget) || 0;\nconst teamSize = Number(lead.team_size) || 0;\nconst timeline = String(lead.timeline || '').toLowerCase();\n\nlet score = 0;\n\n// Budget — maximum 40 points\nif (budget >= 5000) {\n  score += 40;\n} else if (budget >= 2000) {\n  score += 30;\n} else if (budget >= 1000) {\n  score += 20;\n} else if (budget > 0) {\n  score += 10;\n}\n\n// Team size — maximum 30 points\nif (teamSize >= 50) {\n  score += 30;\n} else if (teamSize >= 20) {\n  score += 20;\n} else if (teamSize >= 5) {\n  score += 10;\n}\n\n// Timeline — maximum 30 points\nif (\n  timeline.includes('this week') ||\n  timeline.includes('immediately') ||\n  timeline.includes('asap')\n) {\n  score += 30;\n} else if (\n  timeline.includes('this month') ||\n  timeline.includes('month')\n) {\n  score += 20;\n} else if (\n  timeline.includes('quarter') ||\n  timeline.includes('3 month')\n) {\n  score += 10;\n}\n\n// Qualification\nlet qualification = 'Cold';\n\nif (score >= 70) {\n  qualification = 'Hot';\n} else if (score >= 40) {\n  qualification = 'Warm';\n}\n\nlet qualificationReason = '';\n\nif (qualification === 'Hot') {\n  qualificationReason =\n    `High-priority lead with a budget of $${budget}, ` +\n    `a team size of ${teamSize}, and a timeline of \"${lead.timeline}\".`;\n} else if (qualification === 'Warm') {\n  qualificationReason =\n    `Promising lead with a budget of $${budget}, ` +\n    `a team size of ${teamSize}, and a timeline of \"${lead.timeline}\".`;\n} else {\n  qualificationReason =\n    `Lower-priority lead with a budget of $${budget}, ` +\n    `a team size of ${teamSize}, and a timeline of \"${lead.timeline}\".`;\n}\n\nreturn {\n  json: {\n    ...lead,\n    lead_score: score,\n    qualification: qualification,\n    qualification_reason: qualificationReason\n  }\n};"
      },
