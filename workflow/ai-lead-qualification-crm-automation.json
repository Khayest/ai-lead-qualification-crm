      "parameters": {
        "sendTo": "YOUR_NOTIFICATION_EMAIL@example.com",
        "subject": "=🔥 Hot Lead Alert - {{ $json.name }} - Score {{ $json.lead_score }}",
        "message": "={{\n`\n<h2>🔥 Hot Lead Alert</h2>\n\n<p>A new high-priority lead has been received and qualified.</p>\n\n<table>\n  <tr>\n    <td><strong>Name:</strong></td>\n    <td>${$json.name}</td>\n  </tr>\n  <tr>\n    <td><strong>Company:</strong></td>\n    <td>${$json.company}</td>\n  </tr>\n  <tr>\n    <td><strong>Email:</strong></td>\n    <td>${$json.email}</td>\n  </tr>\n  <tr>\n    <td><strong>Lead Score:</strong></td>\n    <td>${$json.lead_score}/100</td>\n  </tr>\n  <tr>\n    <td><strong>Qualification:</strong></td>\n    <td>${$json.qualification}</td>\n  </tr>\n  <tr>\n    <td><strong>Budget:</strong></td>\n    <td>$${$json.budget}</td>\n  </tr>\n  <tr>\n    <td><strong>Team Size:</strong></td>\n    <td>${$json.team_size}</td>\n  </tr>\n  <tr>\n    <td><strong>Timeline:</strong></td>\n    <td>${$json.timeline}</td>\n  </tr>\n  <tr>\n    <td><strong>Requirement:</strong></td>\n    <td>${$json.requirement}</td>\n  </tr>\n</table>\n\n<p><strong>Qualification Reason:</strong><br>\n${$json.qualification_reason}</p>\n\n<p><strong>Recommended Action:</strong> Review and follow up with this lead promptly.</p>\n`\n}}",
